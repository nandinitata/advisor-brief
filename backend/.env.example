# Copy to .env for local dev, or set these in your host's dashboard.

# Model provider: "groq" (hosted Llama, needs a key) or "ollama" (local, default).
AB_LLM_PROVIDER=groq

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# CORS: comma-separated origins, or "*" for a public demo. Any *.vercel.app is
# always allowed. Leave unset for local dev (localhost:3000).
# AB_ALLOW_ORIGINS=https://your-frontend.vercel.app

# Optional: fetch macro/prices live at request time instead of from the cached
# snapshot (falls back to cache on any failure).
# AB_LIVE_DATA=1
